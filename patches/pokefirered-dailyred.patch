diff --git a/src/dailyred_team.c b/src/dailyred_team.c
new file mode 100644
index 0000000..388577d
--- /dev/null
+++ b/src/dailyred_team.c
@@ -0,0 +1,826 @@
+#include "global.h"
+#include "dailyred.h"
+#include "characters.h"
+#include "data.h"
+#include "party_menu.h"
+#include "pokemon.h"
+#include "random.h"
+#include "constants/items.h"
+#include "constants/moves.h"
+#include "constants/region_map_sections.h"
+#include "constants/species.h"
+#include "constants/battle_move_effects.h"
+
+// Random team generator for Daily Red.
+//
+// Rules (see "Team generation" in the project README):
+//   - Daily play: one non-legendary species for each letter of the Wordle
+//     answer, in order, and one legendary in the last slot. Species repeat for
+//     repeated letters only if a distinct team cannot meet the stat minimum.
+//   - Practice/offline play: the original seeded random team generator.
+//   - Level 100 with a random personality (so random nature, gender, ability
+//     and the normal 1/8192 shiny chance), random IVs from MIN_TEAM_IV to 31,
+//     and EVs focused on its two best stats (see AssignFocusedEVs), close to
+//     RED's perfect IVs and hand-picked EV spreads.
+//   - Legal, curated builds: dependable attacks first, then compatible support
+//     and coverage. Near-best choices vary only with the shared team seed.
+//   - Held items fit the finished moveset, including species-specific items.
+//
+// It draws from its own RNG state instead of the game's Random(), so a given
+// seed always produces the same sequence of teams regardless of what else in
+// the game consumed random numbers in between.
+
+#define MAX_CANDIDATE_MOVES  128 // Mew, the largest pool, has under 100
+#define MAX_TOTAL_EVS        510
+#define MAX_STAT_EVS         252
+#define MIN_TEAM_IV          25  // IVs are random from this to 31 (RED's are all 31)
+#define MAX_SPECIES_ATTEMPTS 1000
+#define MAX_MON_ATTEMPTS     10
+#define MAX_TEAM_ATTEMPTS    1000
+
+// Minimum combined base stat total (HP + Atk + Def + Speed + Sp. Atk +
+// Sp. Def) for the player's six. RED's team adds up to 2954 (Pikachu 300,
+// Espeon 525, Snorlax 540, Venusaur 525, Charizard 534, Blastoise 530), while
+// a fully random team averages about 2430. At 2700, a typical team's actual
+// in-battle stats come to about 96% of RED's and roughly 1 team in 25 is
+// stronger than his. Raise it to make the game easier, lower it for harder.
+// Set to 0 to turn the rule off.
+#define MIN_TEAM_BASE_STAT_TOTAL 2700
+
+// Legendary and mythical Pokemon average a base stat total of 613, against
+// 393 for everything else, so the minimum above would put one in most teams
+// (70% of them). Instead, 1 in LEGENDARY_TEAM_ODDS teams gets exactly one and
+// the others get none.
+#define LEGENDARY_TEAM_ODDS 8
+
+static const u16 sLegendaries[] =
+{
+    SPECIES_ARTICUNO, SPECIES_ZAPDOS, SPECIES_MOLTRES, SPECIES_MEWTWO, SPECIES_MEW,
+    SPECIES_RAIKOU, SPECIES_ENTEI, SPECIES_SUICUNE, SPECIES_LUGIA, SPECIES_HO_OH, SPECIES_CELEBI,
+    SPECIES_REGIROCK, SPECIES_REGICE, SPECIES_REGISTEEL, SPECIES_LATIAS, SPECIES_LATIOS,
+    SPECIES_KYOGRE, SPECIES_GROUDON, SPECIES_RAYQUAZA, SPECIES_JIRACHI, SPECIES_DEOXYS,
+};
+
+// Safe general items; conditional items are added only for compatible builds.
+static const u16 sBattleItems[] =
+{
+    ITEM_LEFTOVERS,
+    ITEM_LUM_BERRY,
+    ITEM_SITRUS_BERRY,
+};
+
+// The item that boosts moves of each type by 10%.
+static const u16 sTypeBoostItems[NUMBER_OF_MON_TYPES] =
+{
+    [TYPE_NORMAL]   = ITEM_SILK_SCARF,
+    [TYPE_FIGHTING] = ITEM_BLACK_BELT,
+    [TYPE_FLYING]   = ITEM_SHARP_BEAK,
+    [TYPE_POISON]   = ITEM_POISON_BARB,
+    [TYPE_GROUND]   = ITEM_SOFT_SAND,
+    [TYPE_ROCK]     = ITEM_HARD_STONE,
+    [TYPE_BUG]      = ITEM_SILVER_POWDER,
+    [TYPE_GHOST]    = ITEM_SPELL_TAG,
+    [TYPE_STEEL]    = ITEM_METAL_COAT,
+    [TYPE_MYSTERY]  = ITEM_NONE,
+    [TYPE_FIRE]     = ITEM_CHARCOAL,
+    [TYPE_WATER]    = ITEM_MYSTIC_WATER,
+    [TYPE_GRASS]    = ITEM_MIRACLE_SEED,
+    [TYPE_ELECTRIC] = ITEM_MAGNET,
+    [TYPE_PSYCHIC]  = ITEM_TWISTED_SPOON,
+    [TYPE_ICE]      = ITEM_NEVER_MELT_ICE,
+    [TYPE_DRAGON]   = ITEM_DRAGON_FANG,
+    [TYPE_DARK]     = ITEM_BLACK_GLASSES,
+};
+
+static u16 TeamRandom(u32 *rng)
+{
+    *rng = ISO_RANDOMIZE1(*rng);
+    return *rng >> 16;
+}
+
+static u32 TeamRandom32(u32 *rng)
+{
+    u32 lo = TeamRandom(rng);
+    return lo | ((u32)TeamRandom(rng) << 16);
+}
+
+// Which species may appear on the player's team. Add rules here, e.g.
+// "fully evolved only" or "no legendaries".
+static bool8 IsEligibleSpecies(u16 species)
+{
+    if (species == SPECIES_NONE || species >= NUM_SPECIES)
+        return FALSE;
+    // Unused placeholder slots between Celebi and Treecko.
+    if (species >= SPECIES_OLD_UNOWN_B && species <= SPECIES_OLD_UNOWN_Z)
+        return FALSE;
+    return TRUE;
+}
+
+static u16 GetBaseStatTotal(u16 species)
+{
+    const struct SpeciesInfo *info = &gSpeciesInfo[species];
+
+    return info->baseHP + info->baseAttack + info->baseDefense
+         + info->baseSpeed + info->baseSpAttack + info->baseSpDefense;
+}
+
+static bool8 IsLegendary(u16 species)
+{
+    u8 i;
+
+    for (i = 0; i < ARRAY_COUNT(sLegendaries); i++)
+    {
+        if (sLegendaries[i] == species)
+            return TRUE;
+    }
+    return FALSE;
+}
+
+static bool8 IsSpeciesTaken(u16 species, const u16 *taken, u8 takenCount)
+{
+    u8 i;
+
+    for (i = 0; i < takenCount; i++)
+    {
+        if (taken[i] == species)
+            return TRUE;
+    }
+    return FALSE;
+}
+
+// A random non-legendary species that isn't already on the team.
+static u16 PickSpecies(u32 *rng, const u16 *taken, u8 takenCount)
+{
+    u16 species;
+    s32 i;
+
+    for (i = 0; i < MAX_SPECIES_ATTEMPTS; i++)
+    {
+        species = 1 + TeamRandom(rng) % (NUM_SPECIES - 1);
+        if (IsEligibleSpecies(species) && !IsLegendary(species) && !IsSpeciesTaken(species, taken, takenCount))
+            return species;
+    }
+
+    // Only reachable if the eligibility rules leave almost nothing to pick.
+    for (species = 1; species < NUM_SPECIES; species++)
+    {
+        if (IsEligibleSpecies(species) && !IsLegendary(species) && !IsSpeciesTaken(species, taken, takenCount))
+            return species;
+    }
+    return SPECIES_BULBASAUR;
+}
+
+// Decides whether this team gets a legendary, then draws the other Pokemon
+// until the team meets MIN_TEAM_BASE_STAT_TOTAL (about 1 in 20 draws do), so
+// every qualifying team is equally likely. In the practically impossible case
+// that none does, the strongest team drawn is used.
+static void PickTeamSpecies(u16 *species, u32 *rng)
+{
+    u16 best[PARTY_SIZE];
+    u32 total, bestTotal = 0;
+    s32 attempt;
+    u8 i, first = 0, slot;
+    u16 temp;
+
+    // Decided once per team, before the minimum, so the minimum can't make
+    // legendaries more likely.
+    if (TeamRandom(rng) % LEGENDARY_TEAM_ODDS == 0)
+        species[first++] = sLegendaries[TeamRandom(rng) % ARRAY_COUNT(sLegendaries)];
+
+    for (attempt = 0; attempt < MAX_TEAM_ATTEMPTS; attempt++)
+    {
+        total = 0;
+        for (i = 0; i < PARTY_SIZE; i++)
+        {
+            if (i >= first)
+                species[i] = PickSpecies(rng, species, i);
+            total += GetBaseStatTotal(species[i]);
+        }
+        if (total >= MIN_TEAM_BASE_STAT_TOTAL)
+            break;
+        if (total > bestTotal)
+        {
+            bestTotal = total;
+            memcpy(best, species, sizeof(best));
+        }
+    }
+    if (attempt == MAX_TEAM_ATTEMPTS)
+        memcpy(species, best, sizeof(best));
+
+    // Put the legendary (if any) in a random party slot instead of the lead.
+    slot = TeamRandom(rng) % PARTY_SIZE;
+    SWAP(species[0], species[slot], temp);
+}
+
+static bool8 StartsWithLetter(u16 species, u8 letter)
+{
+    return IsEligibleSpecies(species) && !IsLegendary(species)
+        && gSpeciesNames[species][0] == CHAR_A + letter - 'a';
+}
+
+// Letters have disjoint species pools. For repeated letters, taking the best
+// unused species each time gives the exact highest possible total.
+static bool8 PickStrongestWordSpecies(u16 *team, const u8 *word, bool8 allowRepeats, u32 *total)
+{
+    u8 i;
+    u16 species, best, value, bestValue;
+
+    *total = 0;
+    for (i = 0; i < DAILYRED_WORD_LENGTH; i++)
+    {
+        best = SPECIES_NONE;
+        bestValue = 0;
+        for (species = 1; species < NUM_SPECIES; species++)
+        {
+            if (!StartsWithLetter(species, word[i])
+             || (!allowRepeats && IsSpeciesTaken(species, team, i)))
+                continue;
+            value = GetBaseStatTotal(species);
+            if (value > bestValue)
+            {
+                best = species;
+                bestValue = value;
+            }
+        }
+        if (best == SPECIES_NONE)
+            return FALSE;
+        team[i] = best;
+        *total += bestValue;
+    }
+    return TRUE;
+}
+
+// Reservoir sampling gives every allowed species for this letter equal odds.
+static u16 PickWordSpecies(u32 *rng, u8 letter, const u16 *taken, u8 count, bool8 allowRepeats)
+{
+    u16 species, chosen = SPECIES_NONE, matches = 0;
+
+    for (species = 1; species < NUM_SPECIES; species++)
+    {
+        if (!StartsWithLetter(species, letter)
+         || (!allowRepeats && IsSpeciesTaken(species, taken, count)))
+            continue;
+        matches++;
+        if (TeamRandom(rng) % matches == 0)
+            chosen = species;
+    }
+    return chosen;
+}
+
+// Choose the sixth slot only after the five letter-matched species are known.
+// Every legendary that brings this particular team to the minimum has equal odds.
+static u16 PickQualifyingLegendary(u32 *rng, u32 subtotal)
+{
+    u16 chosen = SPECIES_NONE;
+    u8 i, matches = 0;
+
+    for (i = 0; i < ARRAY_COUNT(sLegendaries); i++)
+    {
+        if (subtotal + GetBaseStatTotal(sLegendaries[i]) < MIN_TEAM_BASE_STAT_TOTAL)
+            continue;
+        matches++;
+        if (TeamRandom(rng) % matches == 0)
+            chosen = sLegendaries[i];
+    }
+    return chosen;
+}
+
+static void PickWordTeamSpecies(u16 *species, u32 *rng, const u8 *word)
+{
+    u16 strongest[DAILYRED_WORD_LENGTH];
+    u16 bestLegendary = sLegendaries[0];
+    u32 maximum, subtotal;
+    u8 i;
+    bool8 allowRepeats = FALSE;
+    s32 attempt;
+
+    for (i = 1; i < ARRAY_COUNT(sLegendaries); i++)
+    {
+        if (GetBaseStatTotal(sLegendaries[i]) > GetBaseStatTotal(bestLegendary))
+            bestLegendary = sLegendaries[i];
+    }
+    if (!PickStrongestWordSpecies(strongest, word, FALSE, &maximum))
+        maximum = 0;
+    if (maximum + GetBaseStatTotal(bestLegendary) < MIN_TEAM_BASE_STAT_TOTAL)
+    {
+        allowRepeats = TRUE;
+        PickStrongestWordSpecies(strongest, word, TRUE, &maximum);
+    }
+    // A contrived five-letter input may make 2700 mathematically impossible.
+    // Keep the game playable with the strongest possible matching team then.
+    if (maximum + GetBaseStatTotal(bestLegendary) < MIN_TEAM_BASE_STAT_TOTAL)
+    {
+        memcpy(species, strongest, sizeof(strongest));
+        species[DAILYRED_WORD_LENGTH] = bestLegendary;
+        return;
+    }
+
+    for (attempt = 0; attempt < MAX_TEAM_ATTEMPTS; attempt++)
+    {
+        subtotal = 0;
+        for (i = 0; i < DAILYRED_WORD_LENGTH; i++)
+        {
+            species[i] = PickWordSpecies(rng, word[i], species, i, allowRepeats);
+            if (species[i] == SPECIES_NONE)
+                break;
+            subtotal += GetBaseStatTotal(species[i]);
+        }
+        if (i == DAILYRED_WORD_LENGTH)
+        {
+            species[DAILYRED_WORD_LENGTH] = PickQualifyingLegendary(rng, subtotal);
+            if (species[DAILYRED_WORD_LENGTH] != SPECIES_NONE)
+                return;
+        }
+    }
+    // This is guaranteed to qualify whenever a viable legendary was found.
+    memcpy(species, strongest, sizeof(strongest));
+    species[DAILYRED_WORD_LENGTH] = PickQualifyingLegendary(rng, maximum);
+}
+
+static void AddCandidateMove(u16 *moves, u8 *count, u16 move)
+{
+    u8 i;
+
+    if (move == MOVE_NONE || move >= MOVES_COUNT || *count >= MAX_CANDIDATE_MOVES)
+        return;
+    for (i = 0; i < *count; i++)
+    {
+        if (moves[i] == move)
+            return;
+    }
+    moves[(*count)++] = move;
+}
+
+// Every move the Pokemon can learn by level-up (any level) or TM/HM.
+// Other sources (move tutors, egg moves) can be added here.
+static u8 GetLearnableMoves(struct Pokemon *mon, u16 *moves)
+{
+    u16 species = GetMonData(mon, MON_DATA_SPECIES);
+    const u16 *learnset = gLevelUpLearnsets[species];
+    u8 count = 0;
+    u8 i;
+
+    for (i = 0; learnset[i] != LEVEL_UP_END; i++)
+        AddCandidateMove(moves, &count, learnset[i] & LEVEL_UP_MOVE_ID);
+
+    for (i = 0; i < NUM_TECHNICAL_MACHINES + NUM_HIDDEN_MACHINES; i++)
+    {
+        if (CanMonLearnTMHM(mon, i))
+            AddCandidateMove(moves, &count, ItemIdToBattleMoveId(ITEM_TM01_FOCUS_PUNCH + i));
+    }
+    return count;
+}
+
+static bool8 IsDamagingMove(u16 move)
+{
+    // Fixed-damage moves (Seismic Toss, Dragon Rage, ...) have power 1.
+    return gBattleMoves[move].power != 0;
+}
+
+// Only attacks usable immediately and repeatedly can fill the dependable
+// slots. Power 1 is an engine sentinel, not necessarily a weak attack.
+static u16 ReliablePower(u16 move)
+{
+    const struct BattleMove *info = &gBattleMoves[move];
+    if (info->accuracy != 0 && info->accuracy < 90)
+        return 0;
+    switch (info->effect)
+    {
+    case EFFECT_LEVEL_DAMAGE: return 100;
+    case EFFECT_EXPLOSION:
+    case EFFECT_DREAM_EATER:
+    case EFFECT_RECHARGE:
+    case EFFECT_RAZOR_WIND:
+    case EFFECT_SKY_ATTACK:
+    case EFFECT_SKULL_BASH:
+    case EFFECT_SOLAR_BEAM:
+    case EFFECT_SEMI_INVULNERABLE:
+    case EFFECT_FOCUS_PUNCH:
+    case EFFECT_SNORE:
+    case EFFECT_FAKE_OUT:
+    case EFFECT_FALSE_SWIPE:
+    case EFFECT_SPIT_UP:
+    case EFFECT_ERUPTION:
+    case EFFECT_OVERHEAT:
+    case EFFECT_SUPERPOWER:
+    case EFFECT_RAMPAGE:
+    case EFFECT_ROLLOUT:
+        return 0;
+    }
+    return info->power >= 50 ? info->power : 0;
+}
+
+static bool8 HasMove(const u16 *moves, u8 count, u16 move)
+{
+    return IsSpeciesTaken(move, moves, count);
+}
+
+static bool8 HasAttackCategory(const u16 *moves, u8 count, bool8 physical)
+{
+    u8 i;
+    for (i = 0; i < count; i++)
+        if (gBattleMoves[moves[i]].power > 1
+         && IS_TYPE_PHYSICAL(gBattleMoves[moves[i]].type) == physical)
+            return TRUE;
+    return FALSE;
+}
+
+// A deliberately small support pool, with setup matched to Gen 3's type-based
+// physical/special split. No unpaired Sleep Talk, weather, or random gimmicks.
+static bool8 UsefulSupport(u16 move, const u16 *chosen, u8 count)
+{
+    u8 i;
+    u8 effect = gBattleMoves[move].effect;
+    for (i = 0; i < count; i++)
+    {
+        u8 other = gBattleMoves[chosen[i]].effect;
+        if (gBattleMoves[chosen[i]].power == 0)
+        {
+            // At most one recovery move and one status-inflicting move.
+            if ((effect == EFFECT_RESTORE_HP || effect == EFFECT_SOFTBOILED || effect == EFFECT_REST
+              || effect == EFFECT_MORNING_SUN || effect == EFFECT_MOONLIGHT || effect == EFFECT_SYNTHESIS)
+             && (other == EFFECT_RESTORE_HP || other == EFFECT_SOFTBOILED || other == EFFECT_REST
+              || other == EFFECT_MORNING_SUN || other == EFFECT_MOONLIGHT || other == EFFECT_SYNTHESIS))
+                return FALSE;
+            if ((effect == EFFECT_SLEEP || effect == EFFECT_PARALYZE || effect == EFFECT_TOXIC || effect == EFFECT_WILL_O_WISP)
+             && (other == EFFECT_SLEEP || other == EFFECT_PARALYZE || other == EFFECT_TOXIC || other == EFFECT_WILL_O_WISP))
+                return FALSE;
+        }
+    }
+    switch (move)
+    {
+    case MOVE_RECOVER: case MOVE_SOFT_BOILED: case MOVE_MILK_DRINK:
+    case MOVE_SLACK_OFF: case MOVE_SYNTHESIS: case MOVE_MORNING_SUN:
+    case MOVE_MOONLIGHT: case MOVE_REST:
+    case MOVE_SPORE: case MOVE_SLEEP_POWDER: case MOVE_THUNDER_WAVE:
+    case MOVE_WILL_O_WISP: case MOVE_TOXIC: case MOVE_LEECH_SEED:
+    case MOVE_ENCORE: case MOVE_REFLECT: case MOVE_LIGHT_SCREEN:
+        return TRUE;
+    case MOVE_SWORDS_DANCE: case MOVE_BULK_UP: case MOVE_DRAGON_DANCE:
+        return HasAttackCategory(chosen, count, TRUE);
+    case MOVE_CALM_MIND: case MOVE_TAIL_GLOW:
+        return HasAttackCategory(chosen, count, FALSE);
+    case MOVE_PROTECT:
+        return HasMove(chosen, count, MOVE_TOXIC) || HasMove(chosen, count, MOVE_LEECH_SEED);
+    }
+    return FALSE;
+}
+
+static u32 AttackScore(u16 species, u16 move, const u16 *chosen, u8 count)
+{
+    const struct SpeciesInfo *info = &gSpeciesInfo[species];
+    u16 power = ReliablePower(move);
+    u8 type = gBattleMoves[move].type;
+    u8 i;
+    u32 score;
+    if (!IsDamagingMove(move)) return 0;
+    // Weak/conditional attacks remain available only as fallbacks or extras.
+    if (!power) power = min(gBattleMoves[move].power, 40);
+    score = power * (IS_TYPE_PHYSICAL(type) ? info->baseAttack : info->baseSpAttack);
+    if (gBattleMoves[move].effect == EFFECT_LEVEL_DAMAGE)
+        score = 8000; // Fixed damage does not use Attack, Sp. Atk or STAB.
+    else if (type == info->types[0] || type == info->types[1])
+        score = score * 3 / 2;
+    score = score * (gBattleMoves[move].accuracy ? gBattleMoves[move].accuracy : 100) / 100;
+    for (i = 0; i < count; i++)
+        if (IsDamagingMove(chosen[i]) && gBattleMoves[chosen[i]].type == type)
+            return score / 2;
+    return score;
+}
+
+static u16 PickBuildMove(u16 species, const u16 *pool, u8 size, const u16 *chosen, u8 count, bool8 support, u32 *rng)
+{
+    u32 scores[MAX_CANDIDATE_MOVES] = {0};
+    u32 best = 0;
+    u16 result = MOVE_NONE;
+    u8 i, matches = 0;
+    bool8 reliable = FALSE, coverage = FALSE;
+    // The first two attacks use reliable moves whenever possible. Prefer a
+    // different type for the second, but never force an unusable attack.
+    for (i = 0; i < size; i++)
+        if (!HasMove(chosen, count, pool[i]) && ReliablePower(pool[i]))
+        {
+            reliable = TRUE;
+            if (count == 1 && gBattleMoves[pool[i]].type != gBattleMoves[chosen[0]].type)
+                coverage = TRUE;
+        }
+    for (i = 0; i < size; i++)
+    {
+        u16 move = pool[i];
+        if (HasMove(chosen, count, move)) continue;
+        if (support)
+            scores[i] = UsefulSupport(move, chosen, count) ? 100 : 0;
+        else
+        {
+            if (count < 2 && reliable && !ReliablePower(move)) continue;
+            if (count == 1 && coverage && gBattleMoves[move].type == gBattleMoves[chosen[0]].type) continue;
+            scores[i] = AttackScore(species, move, chosen, count);
+        }
+        if (scores[i] > best) best = scores[i];
+    }
+    // Reservoir sample only near-best choices: variety without weak filler.
+    for (i = 0; i < size; i++)
+        if (scores[i] && scores[i] * 100 >= best * 85)
+            if (TeamRandom(rng) % ++matches == 0) result = pool[i];
+    return result;
+}
+
+static void AssignBuildMoves(struct Pokemon *mon, u32 *rng)
+{
+    u16 pool[MAX_CANDIDATE_MOVES], chosen[MAX_MON_MOVES] = {0};
+    u16 species = GetMonData(mon, MON_DATA_SPECIES);
+    u8 size = GetLearnableMoves(mon, pool);
+    u8 count, i;
+    for (count = 0; count < min(size, MAX_MON_MOVES); count++)
+    {
+        bool8 support = count == 2 || (count == 3 && TeamRandom(rng) % 2 == 0);
+        chosen[count] = PickBuildMove(species, pool, size, chosen, count, support, rng);
+        if (chosen[count] == MOVE_NONE)
+            chosen[count] = PickBuildMove(species, pool, size, chosen, count, !support, rng);
+        // Specialists such as Ditto, Unown and Wobbuffet keep their limited
+        // legal options even when a standard attacking build is impossible.
+        if (chosen[count] == MOVE_NONE)
+            for (i = 0; i < size; i++)
+                if (!HasMove(chosen, count, pool[i]))
+                {
+                    chosen[count] = pool[i];
+                    break;
+                }
+    }
+    for (i = 0; i < MAX_MON_MOVES; i++) SetMonMoveSlot(mon, chosen[i], i);
+}
+
+// Item suitability is evaluated after stats and moves are finalized. Scores
+// are design heuristics, not predicted win rates. Choice-locking a utility
+// move is usable with a switch; locking recovery or setup breaks that build.
+static u16 ScoreBuildItem(struct Pokemon *mon, u16 item)
+{
+    u16 species = GetMonData(mon, MON_DATA_SPECIES);
+    const struct SpeciesInfo *info = &gSpeciesInfo[species];
+    u16 hp = GetMonData(mon, MON_DATA_MAX_HP);
+    u8 physical = 0, special = 0, reliablePhysical = 0, i;
+    bool8 choiceCompatible = TRUE, setup = FALSE, sustain = FALSE, rest = FALSE;
+    bool8 boostPrimary = FALSE, boostAttack = FALSE;
+    for (i = 0; i < MAX_MON_MOVES; i++)
+    {
+        u16 move = GetMonData(mon, MON_DATA_MOVE1 + i);
+        u8 effect = gBattleMoves[move].effect;
+        if (move == MOVE_NONE) continue;
+        if (move == MOVE_REST) rest = TRUE;
+        if (gBattleMoves[move].power > 1)
+        {
+            if (IS_TYPE_PHYSICAL(gBattleMoves[move].type))
+            {
+                physical++;
+                if (ReliablePower(move)) reliablePhysical++;
+            }
+            else special++;
+            if (sTypeBoostItems[gBattleMoves[move].type] == item)
+            {
+                boostAttack = TRUE;
+                if (i == 0) boostPrimary = TRUE;
+            }
+        }
+        if (!(gBattleMoves[move].power > 1 && IS_TYPE_PHYSICAL(gBattleMoves[move].type))
+         && move != MOVE_TOXIC && move != MOVE_THUNDER_WAVE && move != MOVE_ENCORE)
+            choiceCompatible = FALSE;
+        switch (effect)
+        {
+        case EFFECT_ATTACK_UP_2: case EFFECT_BULK_UP: case EFFECT_DRAGON_DANCE:
+        case EFFECT_CALM_MIND: case EFFECT_SPECIAL_ATTACK_UP_2:
+            setup = TRUE;
+            break;
+        case EFFECT_RESTORE_HP: case EFFECT_SOFTBOILED: case EFFECT_REST:
+        case EFFECT_MORNING_SUN: case EFFECT_MOONLIGHT: case EFFECT_SYNTHESIS:
+        case EFFECT_LEECH_SEED: case EFFECT_TOXIC: case EFFECT_PROTECT:
+            sustain = TRUE;
+            break;
+        }
+    }
+    // Rest is deliberately paired with an immediate wake-up in this format.
+    if (rest) return item == ITEM_CHESTO_BERRY ? 250 : 0;
+    switch (item)
+    {
+    case ITEM_LIGHT_BALL: return species == SPECIES_PIKACHU && special ? 200 : 0;
+    case ITEM_THICK_CLUB: return (species == SPECIES_CUBONE || species == SPECIES_MAROWAK) && physical ? 200 : 0;
+    case ITEM_SOUL_DEW: return (species == SPECIES_LATIAS || species == SPECIES_LATIOS) && special ? 200 : 0;
+    case ITEM_DEEP_SEA_TOOTH: return species == SPECIES_CLAMPERL && special ? 200 : 0;
+    case ITEM_CHOICE_BAND:
+        return choiceCompatible && physical >= 3 && reliablePhysical >= 2
+            && GetMonData(mon, MON_DATA_ATK) >= GetMonData(mon, MON_DATA_SPATK) ? 150 : 0;
+    case ITEM_LEFTOVERS:
+        return hp > 1 ? 70 + (sustain ? 35 : 0)
+            + (info->baseHP + info->baseDefense + info->baseSpDefense >= 250 ? 25 : 0) : 0;
+    case ITEM_LUM_BERRY: return setup ? 135 : 65;
+    case ITEM_SITRUS_BERRY: return hp > 1 ? (hp <= 180 ? 85 : 45) : 0;
+    case ITEM_CHESTO_BERRY: return 0;
+    }
+    return boostAttack ? 75 + (boostPrimary ? 15 : 0) + (physical + special >= 3 ? 15 : 0) : 0;
+}
+
+static void AssignBuildItem(struct Pokemon *mon, u32 *rng)
+{
+    u16 items[ARRAY_COUNT(sBattleItems) + MAX_MON_MOVES + 6];
+    u16 scores[ARRAY_COUNT(items)], best = 0, item = ITEM_LEFTOVERS;
+    u8 count = 0, i, j, matches = 0;
+    for (i = 0; i < ARRAY_COUNT(sBattleItems); i++)
+        items[count++] = sBattleItems[i];
+    items[count++] = ITEM_CHOICE_BAND;
+    items[count++] = ITEM_CHESTO_BERRY;
+    items[count++] = ITEM_LIGHT_BALL;
+    items[count++] = ITEM_THICK_CLUB;
+    items[count++] = ITEM_SOUL_DEW;
+    items[count++] = ITEM_DEEP_SEA_TOOTH;
+    for (i = 0; i < MAX_MON_MOVES; i++)
+    {
+        u16 move = GetMonData(mon, MON_DATA_MOVE1 + i);
+        if (gBattleMoves[move].power <= 1) continue;
+        item = sTypeBoostItems[gBattleMoves[move].type];
+        for (j = 0; j < count && items[j] != item; j++)
+            ;
+        if (item != ITEM_NONE && j == count) items[count++] = item;
+    }
+    for (i = 0; i < count; i++)
+    {
+        scores[i] = ScoreBuildItem(mon, items[i]);
+        if (scores[i] > best) best = scores[i];
+    }
+    // Preserve daily variety only among similarly suitable items.
+    for (i = 0; i < count; i++)
+        if (scores[i] && scores[i] * 100 >= best * 90)
+            if (TeamRandom(rng) % ++matches == 0) item = items[i];
+    SetMonData(mon, MON_DATA_HELD_ITEM, &item);
+}
+
+// When two stats have the same base value, the one listed first wins.
+static const u8 sEVStatPriority[NUM_STATS] = {STAT_ATK, STAT_SPATK, STAT_SPEED, STAT_HP, STAT_DEF, STAT_SPDEF};
+
+// Trains the Pokemon like RED's: 252 EVs into each of its two highest base
+// stats and the last 6 into HP (or its third-best stat if HP is one of the
+// two). Attack and Sp. Atk only count if one of its attacks uses them; in
+// Gen 3 a move's type decides which (IS_TYPE_PHYSICAL). Needs the moves set.
+static void AssignFocusedEVs(struct Pokemon *mon)
+{
+    const struct SpeciesInfo *info = &gSpeciesInfo[GetMonData(mon, MON_DATA_SPECIES)];
+    u8 base[NUM_STATS];
+    bool8 usable[NUM_STATS] = {TRUE, FALSE, TRUE, TRUE, FALSE, TRUE};
+    u8 order[NUM_STATS];
+    u8 evs[NUM_STATS] = {0};
+    u8 count = 0;
+    u8 i, j, stat;
+    u16 move;
+
+    base[STAT_HP] = info->baseHP;
+    base[STAT_ATK] = info->baseAttack;
+    base[STAT_DEF] = info->baseDefense;
+    base[STAT_SPEED] = info->baseSpeed;
+    base[STAT_SPATK] = info->baseSpAttack;
+    base[STAT_SPDEF] = info->baseSpDefense;
+
+    // Status moves and fixed-damage moves (power 1) don't use either stat.
+    for (i = 0; i < MAX_MON_MOVES; i++)
+    {
+        move = GetMonData(mon, MON_DATA_MOVE1 + i);
+        if (gBattleMoves[move].power <= 1)
+            continue;
+        if (IS_TYPE_PHYSICAL(gBattleMoves[move].type))
+            usable[STAT_ATK] = TRUE;
+        else
+            usable[STAT_SPATK] = TRUE;
+    }
+
+    // Usable stats from highest base stat to lowest (insertion sort, stable
+    // so ties keep sEVStatPriority order).
+    for (i = 0; i < NUM_STATS; i++)
+    {
+        stat = sEVStatPriority[i];
+        if (!usable[stat])
+            continue;
+        for (j = count; j > 0 && base[order[j - 1]] < base[stat]; j--)
+            order[j] = order[j - 1];
+        order[j] = stat;
+        count++;
+    }
+
+    evs[order[0]] = MAX_STAT_EVS;
+    evs[order[1]] = MAX_STAT_EVS;
+    stat = (order[0] != STAT_HP && order[1] != STAT_HP) ? STAT_HP : order[2];
+    evs[stat] = MAX_TOTAL_EVS - 2 * MAX_STAT_EVS;
+
+    for (stat = 0; stat < NUM_STATS; stat++)
+        SetMonData(mon, MON_DATA_HP_EV + stat, &evs[stat]);
+}
+
+// A level 100 Pokemon with a random personality, owned by the player
+// (OT_ID_PLAYER_ID), so it obeys without badges.
+static void CreateTeamMon(struct Pokemon *mon, u16 species, u32 *rng)
+{
+    CreateMon(mon, species, MAX_LEVEL, 0, TRUE, TeamRandom32(rng), OT_ID_PLAYER_ID, 0);
+}
+
+// IVs, EVs, held item and final stats, once the moves are set.
+static void FinishTeamMon(struct Pokemon *mon, u32 *rng)
+{
+    u8 metLocation = METLOC_FATEFUL_ENCOUNTER;
+    u8 fateful = TRUE;
+    u8 i, iv;
+
+    for (i = 0; i < NUM_STATS; i++)
+    {
+        iv = MIN_TEAM_IV + TeamRandom(rng) % (MAX_PER_STAT_IVS - MIN_TEAM_IV + 1);
+        SetMonData(mon, MON_DATA_HP_IV + i, &iv);
+    }
+    AssignFocusedEVs(mon);
+
+    // Mew and Deoxys disobey unless marked as event Pokemon.
+    SetMonData(mon, MON_DATA_MODERN_FATEFUL_ENCOUNTER, &fateful);
+    SetMonData(mon, MON_DATA_MET_LOCATION, &metLocation);
+
+    CalculateMonStats(mon);
+    AssignBuildItem(mon, rng);
+}
+
+static void CreateRandomMon(struct Pokemon *mon, u16 species, u32 *rng)
+{
+    CreateTeamMon(mon, species, rng);
+    AssignBuildMoves(mon, rng);
+    FinishTeamMon(mon, rng);
+}
+
+static bool8 IsValidTeamMon(struct Pokemon *mon)
+{
+    u16 moves[MAX_MON_MOVES];
+    u8 i, j;
+
+    if (!IsEligibleSpecies(GetMonData(mon, MON_DATA_SPECIES)))
+        return FALSE;
+    if (GetMonData(mon, MON_DATA_LEVEL) != MAX_LEVEL)
+        return FALSE;
+    if (GetMonData(mon, MON_DATA_MAX_HP) == 0 || GetMonData(mon, MON_DATA_HP) != GetMonData(mon, MON_DATA_MAX_HP))
+        return FALSE;
+
+    for (i = 0; i < MAX_MON_MOVES; i++)
+        moves[i] = GetMonData(mon, MON_DATA_MOVE1 + i);
+    if (moves[0] == MOVE_NONE || GetMonData(mon, MON_DATA_HELD_ITEM) == ITEM_NONE)
+        return FALSE;
+    for (i = 0; i < MAX_MON_MOVES; i++)
+    {
+        if (moves[i] == MOVE_NONE)
+            continue;
+        if (GetMonData(mon, MON_DATA_PP1 + i) == 0)
+            return FALSE;
+        for (j = i + 1; j < MAX_MON_MOVES; j++)
+        {
+            if (moves[i] == moves[j])
+                return FALSE;
+        }
+    }
+    return TRUE;
+}
+
+static bool8 IsValidFixedWordTeam(const u16 *species, const u8 *word)
+{
+    u8 i;
+
+    if (word == NULL || !IsLegendary(species[DAILYRED_WORD_LENGTH]))
+        return FALSE;
+    for (i = 0; i < DAILYRED_WORD_LENGTH; i++)
+    {
+        if (!StartsWithLetter(species[i], word[i]))
+            return FALSE;
+    }
+    return TRUE;
+}
+
+void DailyRed_GenerateTeam(struct Pokemon *party, u32 *rngState, const u8 *word, const u16 *fixedSpecies)
+{
+    u16 species[PARTY_SIZE];
+    u8 i, attempt;
+
+    for (i = 0; i < PARTY_SIZE; i++)
+        ZeroMonData(&party[i]);
+
+    if (fixedSpecies != NULL && IsValidFixedWordTeam(fixedSpecies, word))
+        memcpy(species, fixedSpecies, sizeof(species));
+    else if (word != NULL)
+        PickWordTeamSpecies(species, rngState, word);
+    else
+        PickTeamSpecies(species, rngState);
+    for (i = 0; i < PARTY_SIZE; i++)
+    {
+        for (attempt = 0; attempt < MAX_MON_ATTEMPTS; attempt++)
+        {
+            CreateRandomMon(&party[i], species[i], rngState);
+            if (IsValidTeamMon(&party[i]))
+                break;
+        }
+
+        // Should never happen, but never hand the player a broken Pokemon:
+        // fall back to the game's own default level 100 moveset.
+        if (attempt == MAX_MON_ATTEMPTS)
+        {
+            CreateTeamMon(&party[i], species[i], rngState);
+            FinishTeamMon(&party[i], rngState);
+        }
+    }
+}
